{
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
        "auto": false,
        "prune": false
    },
    "agent": {
        "build": {
            "steps": 250
        }
    },
    "permission": {
        "external_directory": {
            "/tmp/**": "allow"
        }
    },
    "model": "llm-proxy/Opus 5",
    "provider": {
        "llm-proxy": {
            "npm": "@ai-sdk/anthropic",
            "options": {
                "baseURL": "http://10.79.130.202:8800/trajectory/{env:TRAJECTORY_ID}/v1",
		"apiKey": "proxy-placeholder"
            },
            "models": {
                "Opus 5": {
                    "name": "Opus 5",
                    "options": {
                        "thinking": { "type": "adaptive", "display": "summarized" },
                        "effort": "max"
                    }
                }
            }
        }
    }
}
